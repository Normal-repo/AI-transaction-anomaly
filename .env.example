# ==============================================================================
# BankGuard AI (India Edition) - Configuration Template
# Copy this file to `.env` and fill in your actual credentials.
# ==============================================================================

# Database & Core Service
DATABASE_FILE=bank_monitor.db
PORT=8000
HOST=127.0.0.1
DEBUG=True
ENVIRONMENT=development

# Regional & Currency Settings (Indian Banking Rails)
CURRENCY_SYMBOL=₹
CURRENCY_CODE=INR
COUNTRY_CODE=IN

COMPANY_EMAIL=alerts@bankguard.co.in
COMPANY_NAME=BankGuard AI Security Triage

# Live Email SMTP Gateway (Gmail, Outlook, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=BankGuard Fraud Desk
SMTP_USE_TLS=True

# Transactional SMS Gateway (Fast2SMS / Twilio) - Roadmap Part 2
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_SENDER_ID=FSTSMS
