# ==============================================================================
# BankGuard AI (India Edition) - Configuration Template
# ==============================================================================

DATABASE_FILE=bank_monitor.db
PORT=8000
HOST=127.0.0.1
DEBUG=True
ENVIRONMENT=development

CURRENCY_SYMBOL=₹
CURRENCY_CODE=INR
COUNTRY_CODE=IN

# 1. Company Email Alerts (SMTP)
COMPANY_EMAIL=alerts@bankguard.co.in
COMPANY_NAME=BankGuard AI Security Triage

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@bankguard.co.in
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=alerts@bankguard.co.in
SMTP_FROM_NAME=BankGuard Fraud Desk
SMTP_USE_TLS=True

# 2. SMS Gateway Configuration (Mobile Security Alerts)
SMS_PROVIDER=TWILIO
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Fast2SMS (Indian Gateway option)
FAST2SMS_API_KEY=your-fast2sms-api-key
FAST2SMS_SENDER_ID=FSTSMS
